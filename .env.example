# npm run setup creates .env with fresh secrets. Never commit .env.
WAHA_API_KEY=GENERATE_API_KEY
WEBHOOK_TOKEN=GENERATE_WEBHOOK_TOKEN

# echo works without an OpenAI key; change to openai to enable the agent.
AGENT_MODE=echo
OPENAI_API_KEY=
# Set a model available to your OpenAI project before enabling openai mode.
OPENAI_MODEL=

# Optional exact sender IDs, comma-separated. Empty accepts all private senders.
# Usually international digits without + followed by @c.us; some use @lid.
ALLOWED_CHAT_IDS=

# Used by the host-side pairing helper; Compose overrides this for the app.
WAHA_URL=http://localhost:3000

# Next.js server-only connection to the Docker Hono backend.
BACKEND_URL=http://127.0.0.1:3001
